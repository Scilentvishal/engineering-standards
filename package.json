{
  "name": "engineering-standards",
  "version": "0.1.0",
  "description": "A modular, customizable engineering standards and AI coding instruction toolkit.",
  "type": "module",
  "bin": {
    "engineering-standards": "bin/cli.js"
  },
  "files": [
